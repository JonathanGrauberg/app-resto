// app-resto — esquema multi-tenant.
// Regla: toda tabla de negocio lleva `tenantId` y se consulta siempre filtrando por él
// (ver src/lib/tenant-db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Plataforma / tenants
// ─────────────────────────────────────────────────────────────

enum ModuleKey {
  CARTA_QR
  PEDIDOS
  KDS
  CAJA
  RESERVAS
  BI
  MULTI_IDIOMA
  COMPRAS
  MURO
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings       TenantSettings?
  modules        TenantModule[]
  memberships    Membership[]
  areas          Area[]
  tables         Table[]
  tableGroups    TableGroup[]
  sessions       TableSession[]
  categories     Category[]
  products       Product[]
  orders         Order[]
  orderItems     OrderItem[]
  reservations   Reservation[]
  waitlist       WaitlistEntry[]
  purchases      Purchase[]
  walls          Wall[]
  wallMessages   WallMessage[]
  chatRooms      ChatRoom[]
  chatMessages   ChatMessage[]
  chatInvites    ChatInvite[]
  events         Event[]
  notifications  Notification[]
  translations   Translation[]
  modifierGroups ModifierGroup[]
  subscription   Subscription?
  billingPayments BillingPayment[]
  cartItems      CartItem[]
  payments       Payment[]
  cashShifts     CashShift[]
}

/// Cómo se reparten los pedidos para preparar.
enum PrepMode {
  SEPARATE // pantalla de cocina y pantalla de barra
  SINGLE // una sola pantalla (cocina) recibe todo
}

enum MenuTheme {
  SYSTEM
  DARK
  LIGHT
}

model TenantSettings {
  tenantId        String    @id
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tagline         String?
  description     String?
  coverImageUrl   String?
  logoUrl         String?
  /// Imagen al compartir el enlace (WhatsApp, redes). Si falta: portada → logo.
  shareImageUrl   String?
  address         String?
  phone           String?
  instagramUrl    String?
  facebookUrl     String?
  websiteUrl      String?
  googleReviewUrl String?
  /// País: define moneda, zona horaria, medios de pago y textos legales (ver src/lib/region.ts).
  country         String    @default("ES")
  currency        String    @default("EUR")
  locale          String    @default("es-ES")
  timezone        String    @default("Europe/Madrid")
  /// Tema por defecto de la carta pública (el comensal puede cambiarlo).
  menuTheme       MenuTheme @default(DARK)
  /// Cocina y barra separadas, o todo a una sola pantalla.
  prepMode        PrepMode  @default(SEPARATE)
  /// Idiomas adicionales que el tenant decide cargar a mano (ej. ["en","ca"]).
  extraLocales    String[]  @default([])
  /// Horarios de apertura, JSON libre por día: { "mon": [["12:00","16:00"]], ... }
  openingHours    Json?

  // Reservas
  /// Franjas en que se puede reservar, por día: { "mon": [["13:00","15:30"],["20:00","23:00"]], ... } (hora de llegada).
  bookingHours       Json?
  /// Cuánto ocupa una reserva la mesa.
  bookingDurationMin Int      @default(90)
  /// Cada cuántos minutos se ofrece un horario (13:00, 13:30…).
  bookingSlotMin     Int      @default(30)
  /// Tolerancia de espera: pasado este tiempo sin llegar, la reserva se da por no presentada y libera la mesa.
  bookingGraceMin    Int      @default(15)
  /// Antelación mínima para reservar online.
  bookingLeadMin     Int      @default(60)
  /// Hasta cuántos días adelante se puede reservar.
  bookingMaxDays     Int      @default(30)
  /// Máximo de personas por reserva online (más que esto: por teléfono).
  bookingMaxParty    Int      @default(8)
  /// Texto para el cliente al reservar (política, cómo llegar…).
  bookingNotice      String?
  /// Con gente en la lista de espera, la web no ofrece horarios dentro de estos minutos (0 = no se frena).
  waitlistHoldMin    Int      @default(90)
  /// Muro y chat: palabras que el local agrega a la lista de no permitidas.
  blockedWords       String[] @default([])
}

model TenantModule {
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    ModuleKey
  enabled   Boolean   @default(true)
  expiresAt DateTime?

  @@id([tenantId, module])
}

// ─────────────────────────────────────────────────────────────
// Usuarios y roles
// ─────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  CAJA
  MOZO
  COCINA
  BAR
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  name            String
  passwordHash    String?
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())

  memberships Membership[]
  sessions    AuthSession[]
}

/// Pertenencia de un usuario a un tenant con un rol. El PIN es por tenant.
model Membership {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Rol principal: define la pantalla de inicio.
  role       Role
  /// Roles adicionales (ej. Caja que también atiende mesas como Mozo).
  extraRoles Role[]   @default([])
  pinHash    String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  tableSessions  TableSession[]
  ordersCreated  Order[]        @relation("OrderCreatedBy")
  ordersAccepted Order[]        @relation("OrderAcceptedBy")

  @@unique([tenantId, userId])
  @@index([tenantId, role])
}

model AuthSession {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tenant activo de la sesión (null = panel de plataforma).
  tenantId     String?
  membershipId String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Salones y mesas
// ─────────────────────────────────────────────────────────────

model Area {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)
  /// Tamaño del lienzo del plano (unidades de grilla).
  width     Int    @default(20)
  height    Int    @default(12)

  tables Table[]

  @@index([tenantId])
}

enum TableShape {
  SQUARE
  ROUND
  RECT
}

enum TableStatus {
  FREE
  OCCUPIED
  PENDING_PAYMENT
  DISABLED
}

model Table {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  areaId         String
  area           Area        @relation(fields: [areaId], references: [id], onDelete: Cascade)
  number         String
  seats          Int         @default(4)
  maxGuests      Int         @default(4)
  shape          TableShape  @default(SQUARE)
  posX           Int         @default(0)
  posY           Int         @default(0)
  width          Int         @default(2)
  height         Int         @default(2)
  status         TableStatus @default(FREE)
  /// Token aleatorio del QR; regenerable. Nunca usar el id en la URL pública.
  qrToken        String      @unique
  groupId        String?
  group          TableGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Mesa extra agregada durante el servicio (traída del depósito, etc.).
  /// Se elimina sola cuando se cobra la mesa a la que estaba unida.
  temporary      Boolean     @default(false)
  /// Mesa retirada (ej. extra ya cobrada). No aparece en plano ni sala; se conserva para el historial.
  archivedAt     DateTime?
  /// false = solo para quien llega sin reserva (barra, mesas altas): la web nunca la ofrece.
  onlineBookable Boolean     @default(true)

  sessions     TableSession[]
  reservations ReservationTable[]

  @@unique([tenantId, number])
  @@index([tenantId, areaId])
}

/// Mesas unidas temporalmente (comparten sesión y cuenta).
model TableGroup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  tables Table[]

  @@index([tenantId])
}

enum SessionStatus {
  OPEN
  PENDING_PAYMENT
  CLOSED
}

/// Una ocupación de mesa: desde que se abre hasta que caja confirma el cobro.
model TableSession {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tableId           String
  table             Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiterId          String?
  waiter            Membership?   @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  guests            Int           @default(1)
  status            SessionStatus @default(OPEN)
  openedAt          DateTime      @default(now())
  closeRequestedAt  DateTime?
  closedAt          DateTime?
  /// Total de la pre-cuenta al cerrar (céntimos). Para BI.
  totalCents        Int?
  reviewPromptShown Boolean       @default(false)
  waiterCalledAt    DateTime?
  /// Enlace secreto de la cuenta (QR del ticket). Vale mientras la mesa está abierta y 24 h después de cobrar.
  receiptToken      String?       @unique
  /// Nombre de la mesa al cerrar (ej. "3+4"): las mesas juntadas se separan al cobrar.
  tableLabel        String?
  /// Descuento sobre la cuenta (céntimos) y su motivo.
  discountCents     Int           @default(0)
  discountReason    String?

  orders    Order[]
  payments  Payment[]
  cartItems CartItem[]

  @@index([tenantId, status])
  @@index([tableId, status])
}

// ─────────────────────────────────────────────────────────────
// Carta
// ─────────────────────────────────────────────────────────────

enum PrepStation {
  KITCHEN
  BAR
  NONE
}

/// 14 alérgenos de declaración obligatoria (Reglamento UE 1169/2011).
enum Allergen {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOY
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
}

model Category {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int     @default(0)
  visible     Boolean @default(true)

  products Product[]

  @@index([tenantId, sortOrder])
}

model Product {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceCents  Int
  imageUrl    String?
  station     PrepStation @default(KITCHEN)
  allergens   Allergen[]  @default([])
  /// Etiquetas libres: vegano, picante, sin gluten, nuevo...
  tags        String[]    @default([])
  available   Boolean     @default(true)
  visible     Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]
  ownGroup       ModifierGroup?         @relation("ProductOwnGroup")
  cartItems      CartItem[]

  @@index([tenantId, categoryId, sortOrder])
}

/// Grupo de opciones ("Punto de la carne", "Extras").
/// Compartido entre productos, o propio de un plato si tiene `ownerProductId`
/// (los "Extras de este plato" que se cargan desde la ficha del producto).
model ModifierGroup {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  minSelect      Int      @default(0)
  maxSelect      Int      @default(1)
  ownerProductId String?  @unique
  ownerProduct   Product? @relation("ProductOwnGroup", fields: [ownerProductId], references: [id], onDelete: Cascade)

  options  ModifierOption[]
  products ProductModifierGroup[]

  @@index([tenantId])
}

model ModifierOption {
  id              String        @id @default(cuid())
  groupId         String
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  extraPriceCents Int           @default(0)
  sortOrder       Int           @default(0)
}

model ProductModifierGroup {
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder Int           @default(0)

  @@id([productId, groupId])
}

/// Traducciones opcionales cargadas por el tenant.
model Translation {
  id         String @id @default(cuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "Product" | "Category" | "ModifierOption" ...
  entityId   String
  field      String // "name" | "description"
  locale     String
  text       String

  @@unique([entityType, entityId, field, locale])
  @@index([tenantId, locale])
}

// ─────────────────────────────────────────────────────────────
// Carrito compartido y pedidos
// ─────────────────────────────────────────────────────────────

/// Ítem del carrito compartido de la mesa (antes de enviar).
model CartItem {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId String
  session   TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int          @default(1)
  /// [{ groupId, optionId, name, extraPriceCents }]
  modifiers Json         @default("[]")
  notes     String?
  /// Apodo del comensal que lo agregó ("Ana", "Comensal 2").
  addedBy   String?
  /// Id del comensal (cookie de la mesa) que lo agregó: permite editar "lo mío" y dividir la cuenta.
  addedById String?
  createdAt DateTime     @default(now())

  @@index([sessionId])
}

enum OrderStatus {
  PENDING // enviado por la mesa, esperando validación del mozo
  ACCEPTED // validado, repartido a cocina/bar
  REJECTED
  COMPLETED // todos los ítems entregados
}

enum OrderSource {
  GUEST
  STAFF
}

/// Una ronda de pedido dentro de la sesión de mesa.
model Order {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId    String
  session      TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  round        Int
  status       OrderStatus  @default(PENDING)
  source       OrderSource  @default(GUEST)
  createdById  String?
  createdBy    Membership?  @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedById String?
  acceptedBy   Membership?  @relation("OrderAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  rejectReason String?
  createdAt    DateTime     @default(now())
  acceptedAt   DateTime?

  items OrderItem[]

  @@unique([sessionId, round])
  @@index([tenantId, status])
}

enum ItemStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Copia del nombre y precio al momento del pedido (la carta puede cambiar).
  name           String
  unitPriceCents Int
  quantity       Int
  modifiers      Json        @default("[]")
  notes          String?
  /// Comensal que lo pidió (apodo e id), copiado del carrito.
  addedBy        String?
  addedById      String?
  station        PrepStation
  status         ItemStatus  @default(PENDING)
  readyAt        DateTime?
  /// Invitación de la casa: el plato no se cobra.
  comped         Boolean     @default(false)
  /// Cocina/barra no lo pudo hacer (falta un ingrediente…): el plato queda CANCELLED con este motivo.
  cancelReason   String?
  compReason     String?
  deliveredAt    DateTime?

  @@index([tenantId, station, status])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// Reservas y eventos
// ─────────────────────────────────────────────────────────────

enum ReservationStatus {
  CONFIRMED
  SEATED
  NO_SHOW
  CANCELLED
  COMPLETED
}

enum ReservationSource {
  PUBLIC // desde la web del local
  STAFF // cargada por el local (teléfono, evento…)
}

model Reservation {
  id            String            @id @default(cuid())
  /// Código del enlace público para ver o cancelar la reserva.
  code          String            @unique
  source        ReservationSource @default(PUBLIC)
  /// Aceptación de la política de privacidad (RGPD) en reservas online.
  consentAt     DateTime?
  seatedAt      DateTime?
  cancelledAt   DateTime?
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String?
  customerEmail String?
  partySize     Int
  startsAt      DateTime
  endsAt        DateTime
  status        ReservationStatus @default(CONFIRMED)
  notes         String?
  eventId       String?
  event         Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  tables ReservationTable[]

  @@index([tenantId, startsAt])
}

/// Mesa asignada a una reserva. Una exclusión en SQL (migración manual) impide
/// que la misma mesa tenga dos reservas activas con horarios solapados.
model ReservationTable {
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  tableId       String
  table         Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  endsAt        DateTime
  active        Boolean     @default(true)

  @@id([reservationId, tableId])
  @@index([tableId, startsAt])
}

enum WaitlistStatus {
  WAITING
  SEATED
  LEFT // se fue sin sentarse
}

/// Lista de espera presencial: grupos que llegaron sin reserva y esperan mesa.
model WaitlistEntry {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  partySize  Int
  phone      String?
  notes      String?
  status     WaitlistStatus @default(WAITING)
  /// Mesa donde se sentó ("3+4"), para el historial.
  tableLabel String?
  createdAt  DateTime       @default(now())
  seatedAt   DateTime?
  leftAt     DateTime?

  @@index([tenantId, status, createdAt])
}

model Event {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  startsAt DateTime
  endsAt   DateTime
  notes    String?

  reservations Reservation[]

  @@index([tenantId, startsAt])
}

// ─────────────────────────────────────────────────────────────
// Notificaciones
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  ORDER_NO_WAITER
  ORDER_PENDING
  ORDER_ACCEPTED
  ITEM_READY
  WAITER_CALLED
  TABLE_CLOSE_REQUESTED
}

model Notification {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type               NotificationType
  /// Rol destinatario (null = todos) y/o membresía puntual.
  targetRole         Role?
  targetMembershipId String?
  tableId            String?
  sessionId          String?
  orderId            String?
  message            String
  readAt             DateTime?
  createdAt          DateTime         @default(now())

  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Caja: pagos y turnos
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Compras (para comparar lo comprado con lo vendido)
// ─────────────────────────────────────────────────────────────

enum PurchaseCategory {
  FOOD // mercadería
  DRINKS // bebidas
  SUPPLIES // limpieza, descartables, insumos
  OTHER
}

/**
 * Una compra del local: qué, cuánto costó y cuándo.
 */
model Purchase {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Día de la compra (mediodía en la zona del local, para que no se corra de día).
  date        DateTime
  item        String
  /// Texto libre: "10 kg", "2 cajas".
  quantity    String?
  supplier    String?
  category    PurchaseCategory @default(FOOD)
  amountCents Int
  notes       String?
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([tenantId, date])
}

enum PaymentMethod {
  CASH
  CARD
  BIZUM // España
  MERCADOPAGO // Argentina
  TRANSFER
  OTHER
}

/// Un pago de una mesa. Una mesa puede pagarse con varios (dividir, mixto efectivo + tarjeta).
model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       TableSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  shiftId       String?
  shift         CashShift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  method        PaymentMethod
  /// Importe que se aplica a la cuenta (sin propina).
  amountCents   Int
  tipCents      Int           @default(0)
  /// Solo efectivo: lo que entregó el cliente (para calcular el cambio).
  receivedCents Int?
  createdById   String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([shiftId])
}

/// Turno de caja: efectivo inicial, cobros del turno y arqueo al cerrar.
model CashShift {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedAt         DateTime  @default(now())
  openedById       String?
  openingCashCents Int       @default(0)
  closedAt         DateTime?
  closedById       String?
  /// Efectivo contado al cerrar.
  countedCashCents Int?
  notes            String?

  payments Payment[]

  @@index([tenantId, openedAt])
}

// ─────────────────────────────────────────────────────────────
// Muro: mensajes en pantalla gigante por evento, y chat de mesa
// ─────────────────────────────────────────────────────────────

enum WallModeration {
  AUTO // sale en pantalla al instante (con filtro de palabras)
  APPROVE // el local aprueba cada mensaje antes de mostrarlo
}

enum WallMessageStatus {
  VISIBLE
  PENDING
  HIDDEN
}

/**
 * Un muro de evento (despedida, cumpleaños, fin de año…): se escribe por QR y se ve en la pantalla del local.
 */
model Wall {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  startsAt    DateTime
  endsAt      DateTime
  /// Código del QR para escribir (público).
  code        String         @unique
  /// Enlace secreto de la pantalla (lo abre el local en la tele o el proyector).
  screenToken String         @unique
  moderation  WallModeration @default(AUTO)
  /// Video o lista de YouTube de fondo en la pantalla (opcional).
  videoUrl    String?
  /// Personas bloqueadas por el local en este muro (id de la cookie).
  blockedKeys String[]       @default([])
  createdAt   DateTime       @default(now())

  messages WallMessage[]

  @@index([tenantId, startsAt])
}

model WallMessage {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallId     String
  wall       Wall              @relation(fields: [wallId], references: [id], onDelete: Cascade)
  authorKey  String
  authorName String
  text       String
  status     WallMessageStatus @default(VISIBLE)
  createdAt  DateTime          @default(now())

  @@index([wallId, status, createdAt])
}

/**
 * Grupo de chat de una mesa (lo arma el mozo). Se cierra y se borra al cobrar la mesa.
 */
model ChatRoom {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  /// Código del QR del grupo (público).
  code           String    @unique
  /// Mesa a la que pertenece (se cierra con ella). Null = grupo suelto del local.
  sessionId      String?
  tableLabel     String?
  blockedKeys    String[]  @default([])
  /// Quienes entraron al chat (id de la cookie): para aprobar la foto y contar participantes.
  memberKeys     String[]  @default([])
  /// Chat compartido entre mesas ("brindis" aceptado): ids de los grupos que lo forman.
  linkedRoomIds  String[]  @default([])
  /// Foto de la mesa (selfie sacada en el momento, JPEG chico como data URL). Se borra al cerrar.
  photoData      String?
  photoBy        String?
  /// Quienes aprobaron la foto (además de quien la sacó). Con una aprobación queda visible.
  photoApprovals String[]  @default([])
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  messages    ChatMessage[]
  invitesSent ChatInvite[]  @relation("InviteFrom")
  invitesGot  ChatInvite[]  @relation("InviteTo")

  @@index([tenantId, closedAt])
  @@index([sessionId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorKey  String
  authorName String
  text       String
  hidden     Boolean  @default(false)
  /// Quiénes lo reportaron (con 2 reportes se oculta solo).
  reportedBy String[] @default([])
  createdAt  DateTime @default(now())

  @@index([roomId, createdAt])
}

enum ChatInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/**
 * "Brindis": un grupo invita a otro a un chat compartido. Vence a los 15 minutos.
 */
model ChatInvite {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromRoomId  String
  fromRoom    ChatRoom         @relation("InviteFrom", fields: [fromRoomId], references: [id], onDelete: Cascade)
  toRoomId    String
  toRoom      ChatRoom         @relation("InviteTo", fields: [toRoomId], references: [id], onDelete: Cascade)
  status      ChatInviteStatus @default(PENDING)
  /// Chat compartido creado al aceptar.
  jointRoomId String?
  /// La otra mesa no tenía el chat abierto: el aviso va a su mozo, que les pregunta en persona.
  viaWaiter   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@index([toRoomId, status])
  @@index([fromRoomId, status])
}

// ─────────────────────────────────────────────────────────────
// Cobro del SaaS (lo que el local le paga a Yatay). Solo lo usa la plataforma.
// Hoy los pagos se registran a mano; `provider`/`providerRef` quedan para Mercado Pago o Stripe.
// ─────────────────────────────────────────────────────────────

enum BillingProvider {
  MANUAL
  MERCADOPAGO
  STRIPE
}

/// Suscripción de un local: precio mensual, prueba gratis y hasta cuándo está pago.
/// El estado (prueba, al día, vencido, sin cargo) se calcula con estas fechas (src/lib/billing.ts).
model Subscription {
  id          String          @id @default(cuid())
  tenantId    String          @unique
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Plan de referencia (src/lib/plans.ts); los módulos se manejan aparte.
  planId      String?
  /// Precio por mes en centavos de `currency`. 0 = sin cargo (demo, cortesía).
  priceCents  Int             @default(0)
  currency    String
  trialEndsAt DateTime?
  paidUntil   DateTime?
  provider    BillingProvider @default(MANUAL)
  providerRef String?
  notes       String?
  cancelledAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Un pago recibido de un local. Extiende `paidUntil` de su suscripción.
model BillingPayment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String
  /// TRANSFERENCIA, EFECTIVO, MERCADOPAGO, STRIPE, OTRO
  method      String
  months      Int
  periodFrom  DateTime
  periodTo    DateTime
  paidAt      DateTime
  reference   String?
  note        String?
  recordedBy  String?
  createdAt   DateTime @default(now())

  @@index([tenantId, paidAt])
}
