# Neon (región UE). Con pooling para la app y directa (sin "-pooler") para migraciones.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar cookies (mín. 32 caracteres aleatorios; uno distinto por entorno)
SESSION_SECRET=""

# Cloudflare R2 (imágenes)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="app-resto-media"
R2_JURISDICTION="eu"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Ably (tiempo real)
ABLY_API_KEY=""

# Opcional: URL pública fija (para los QR). Si falta, se usa el dominio de la petición.
# APP_URL="https://app-resto.es"
